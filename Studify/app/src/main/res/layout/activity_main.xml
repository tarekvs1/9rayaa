<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#5267E8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_subtitle"
            android:textColor="#667085"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_back"
            android:textColor="#202945"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_description"
            android:textColor="#667085"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStudents"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/menu_students"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnAddStudent"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_add_student"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnGrades"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_grades"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnStatistics"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_statistics"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnTimetable"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_timetable"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnAttendance"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_attendance"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnAssignments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_assignments"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnAnnouncements"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_announcements"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnReportCard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_report_card"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="@string/menu_profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:text="@string/menu_settings"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#5267E8" />

    </LinearLayout>
</ScrollView>
